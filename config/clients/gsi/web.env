VITE_APP_TITLE=GSI ERP
VITE_APP_SHORT_NAME=GSI ERP
VITE_THEME_COLOR="#105098"
# Dashboard hero background photo (inspection/port/vessel), per client profile. Points at a
# static file in apps/web/public/ (served as-is, same as /icons/*), not a build-time import, so
# a white-label deployment can swap it for its own photo without touching component code — see
# docs/WHITE_LABEL.md. Falls back to the built-in abstract port illustration when unset.
VITE_DASHBOARD_HERO_IMAGE=/hero/dashboard-port-vessel.webp
