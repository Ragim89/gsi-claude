# Production environment for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production            # this file holds real secrets once filled in
#
# Every value below is a required variable (docker-compose.prod.yml uses `${VAR:?...}`, not a
# fallback) — `docker compose -f docker-compose.prod.yml --env-file .env.production config` fails
# loudly on the first one left blank instead of silently starting with a development default.
# Never commit .env.production (it is in .gitignore). See docs/DEPLOYMENT.md for how to generate
# and store these, and docs/BACKUP_RESTORE.md / docs/OPERATIONS.md for rotation.

# --- Domains -----------------------------------------------------------------------------------
# Public hostname the app is served from. DNS must point at this host before the first start —
# Caddy requests a certificate for it on boot.
DOMAIN=app.example.com
# Only needed if you self-host MinIO and expose it publicly for presigned URLs (see Caddyfile).
# Leave blank and delete the matching Caddyfile block if you use a managed S3 provider instead.
STORAGE_DOMAIN=storage.example.com
# Let's Encrypt / ZeroSSL will use this address for renewal and abuse notices.
ACME_EMAIL=ops@example.com
# Must match DOMAIN, with the scheme: printed on issued reports' QR codes and used for CORS.
PUBLIC_WEB_URL=https://app.example.com

# --- Database ------------------------------------------------------------------------------------
# `gsi_app` (APP_DB_PASSWORD) is the role the API connects as: RLS is always enforced for it.
# POSTGRES_USER/POSTGRES_PASSWORD is the schema owner: migrations and seeding only, never used
# by a running request. Generate both with: openssl rand -base64 24
POSTGRES_USER=gsi_owner
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# --- Auth ----------------------------------------------------------------------------------------
# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Object storage --------------------------------------------------------------------------------
# Self-hosted MinIO (matches docker-compose.prod.yml's minio service) or any S3-compatible
# provider. If using a managed provider, point S3_ENDPOINT/S3_PUBLIC_ENDPOINT at it, set
# S3_FORCE_PATH_STYLE=false for AWS S3 itself, and remove the minio/caddy STORAGE_DOMAIN wiring.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://storage.example.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=gsi-media

# --- Outbound e-mail (optional; defaults to the console adapter, which sends nothing) -------------
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
