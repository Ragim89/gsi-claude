# Staging environment: the same docker-compose.prod.yml, different .env file.
#
#   cp .env.staging.example .env.staging
#   docker compose -f docker-compose.prod.yml --env-file .env.staging up -d --build
#
# Staging exists to look exactly like production (same images, same reverse proxy, same
# migrations-on-boot), not like development. It uses this file rather than docker-compose.yml
# for that reason. The two differences from .env.production are marked below; every other
# variable follows .env.production.example — see that file for what each one means and how to
# generate it. Never commit .env.staging (it is in .gitignore) and never reuse a production
# secret here: a staging leak should not be a production incident.

DOMAIN=staging.example.com
STORAGE_DOMAIN=staging-storage.example.com
ACME_EMAIL=ops@example.com
PUBLIC_WEB_URL=https://staging.example.com

POSTGRES_USER=gsi_owner
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://staging-storage.example.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=gsi-media-staging

EMAIL_PROVIDER=console        # difference from production: never sends real e-mail to real clients
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Difference from production: staging may carry demo data for manual QA and UAT. Set both to
# 'true' only right after the very first `up`, on an empty database — SEED_ON_START stays on so
# reference data (branches, catalogues) is present, SEED_DEMO adds demo clients/jobs on top of
# it. Never set SEED_DEMO=true against a database that already holds anyone's real data.
SEED_ON_START=false
SEED_DEMO=false
